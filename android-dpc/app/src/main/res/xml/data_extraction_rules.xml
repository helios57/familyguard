<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing on this device is backed up or transferred. The device credential, the recovery hash and
  the enforcement state are all reconstructible from the control plane after a re-enrolment, and a
  copy of them in a cloud backup is a copy of a child's device credential outside anyone's control.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
