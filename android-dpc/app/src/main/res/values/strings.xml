<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">FamilyGuard</string>

    <!-- Shown by Settings wherever the device admin is listed. -->
    <string name="admin_label">FamilyGuard</string>
    <string name="admin_description">Applies the settings a parent chose for this phone. The phone
        can always be reset from the recovery menu.</string>

    <!--
      The foreground-service notification. It is the child's disclosure that the phone is managed
      and the parent's only on-device sign that the connection is alive, so it says what is running
      rather than something reassuring and vague.
    -->
    <string name="connection_channel">Connection</string>
    <string name="connection_running">Connected to the family settings</string>
    <string name="setup_channel">Setup needed</string>

    <!--
      The siren's own channel and its stop control (FR-9). IMPORTANCE_HIGH so it is on screen
      rather than folded into the shade: it is the only way to silence the phone you are holding,
      and a control nobody can find is the defect it was added for.
    -->
    <string name="siren_channel">Ringing</string>
    <string name="siren_title">FamilyGuard is ringing this phone</string>
    <string name="siren_text">Someone asked this phone to ring so it can be found. It stops by itself after five minutes.</string>
    <string name="siren_stop">Stop ringing</string>
    <string name="usage_access_title">Screen time is not being measured</string>
    <string name="usage_access_text">FamilyGuard needs Usage access to see how long apps are used. Without it, screen time reads as zero and daily limits never apply. Tap to open the setting, then turn FamilyGuard on.</string>

    <!--
      The recovery screen (FR-12). Every one of these is read by somebody who is already annoyed:
      a phone has stopped doing something and the parent is standing over it. So each says what
      happened and what to do next, in that order, and none of them says "error".

      They also never name the child's failure. "Wrong code" is what a shoulder-surfing child sees
      too, and it is the only feedback a guesser gets — so it carries no hint about which part was
      wrong, and the count that follows it is the parent's signal, not theirs.
    -->
    <string name="recovery_title">Unlock this phone</string>
    <string name="recovery_explanation">Enter the recovery code from the family settings. The phone
        stops applying the rules until it next reaches the family settings — then whatever is set
        there takes over again.</string>
    <string name="recovery_code_hint">Recovery code</string>
    <string name="recovery_submit">Unlock</string>
    <string name="recovery_footer">This phone can always be reset to factory settings from Android\'s
        own settings or from recovery mode. Nothing here can block that.</string>

    <string name="recovery_checking">Checking…</string>
    <string name="recovery_released">Unlocked. The rules are off until this phone next reaches the
        family settings.</string>
    <!-- %1$s is what the appliers reported. Shown rather than hidden: a partial release is not a release. -->
    <string name="recovery_released_with_problems">Unlocked, but not everything could be turned off:
        %1$s</string>
    <string name="recovery_already_released">Already unlocked. The rules are off until this phone
        next reaches the family settings.</string>
    <!-- %1$s is the reason, from the controller. -->
    <string name="recovery_unavailable">%1$s</string>
    <string name="recovery_empty">Enter the code first.</string>

    <!-- %1$d is how many wrong codes in a row; %2$s is a formatted wait. -->
    <plurals name="recovery_rejected">
        <item quantity="one">That code is not right (%1$d wrong so far).</item>
        <item quantity="other">That code is not right (%1$d wrong in a row).</item>
    </plurals>
    <string name="recovery_rejected_wait">That code is not right (%1$d wrong in a row). Try again in
        %2$s.</string>
    <string name="recovery_locked_out">Too many wrong codes. Try again in %1$s.</string>

    <!--
      The on-device status block (FR-13.4). Read by a parent standing next to the phone, which is
      the one place a question the console cannot answer gets asked: the console knows what it sent,
      and only the phone knows what happened to it.

      `status_flag` is prepended to every line that is not OK. It exists because colour cannot be the
      only signal — a parent who is colour-blind, or reading a phone in sunlight, gets the same
      screen as everyone else — and because the two non-OK levels must look equally unfinished.
      "Not measured" rendered calmly is the whole failure this block was built to make visible.
    -->
    <string name="status_heading">This phone</string>
    <string name="status_loading">Checking…</string>
    <string name="status_flag">⚠</string>
    <!-- %1$s is the label, %2$s the value. Read out as one sentence by a screen reader. -->
    <string name="status_row_description">%1$s: %2$s</string>
    <!-- Same, for a row that needs attention. The word is what carries it without colour. -->
    <string name="status_row_description_attention">Needs attention. %1$s: %2$s</string>
    <string name="status_unavailable">This phone could not read its own status.</string>

    <!--
      The fix button on a status row, and what a screen reader says about it.

      One label for both switches rather than "Allow background activity" / "Allow alarms": the row
      above it already names which switch this is, and a button repeating its own row's label is
      read twice by a screen reader. The spoken description is where the pairing is made explicit,
      because a button reached by swiping arrives with no row context at all.
    -->
    <string name="status_fix">Open settings</string>
    <string name="status_fix_description">Open settings for %1$s</string>
    <!--
      Shown in place of the button when this phone has no screen for that switch. It replaces the
      button rather than sitting beside a dead one: a button that opens nothing reads as the phone
      refusing, and sends a parent looking for a fault that is not there.
    -->
    <string name="status_fix_unavailable">This phone has no screen for that setting.</string>

    <plurals name="recovery_wait_minutes">
        <item quantity="one">%d minute</item>
        <item quantity="other">%d minutes</item>
    </plurals>
    <plurals name="recovery_wait_seconds">
        <item quantity="one">%d second</item>
        <item quantity="other">%d seconds</item>
    </plurals>

    <!-- FR-1.8. The phone is still the device owner and still holds its recovery material; what it
         has lost is the server's acceptance of its credential. Worded so a parent knows the phone
         is not broken and knows the fix is on their side, in the console. -->
    <string name="unlinked_title">This phone is no longer linked</string>
    <string name="unlinked_text">Family Guard cannot report to the family console any more, because the setup code it uses was replaced. Open the console, choose this phone, tap Replace phone, and enter the setup code here. Nothing on the phone needs to be reset.</string>
    <string name="relink_heading">Link this phone again</string>
    <string name="relink_hint">Setup code from the console</string>
    <!--
      Shown above the field on a phone that is linked and working. The unlinked case keeps
      unlinked_text, which explains a problem; this one explains an option, and the difference
      matters because the section is now on screen in both states.
    -->
    <string name="relink_explain_linked">This phone is linked. If the console has issued a new setup code for it — after Replace phone, or because it stopped reporting — type that code here to link it again. Nothing changes until a code is accepted.</string>
    <string name="relink_submit">Link this phone</string>
    <string name="relink_working">Linking…</string>
    <string name="relink_done">Linked. The phone is reporting to the console again.</string>
    <string name="relink_refused">That setup code was not accepted. Codes can only be used once and expire after 30 minutes — issue a new one in the console.</string>
    <string name="relink_deferred">The server could not be reached. Check the phone is online and try again.</string>

    <!-- FR-6.6 to FR-6.9. The ad filter's notification, which is what the child sees of it.
         An Android VPN puts a permanent key icon in the status bar whatever this says, so the
         notification's job is to make that icon explainable rather than mysterious: it names the
         app, says what the tunnel is for, and never implies the phone is being watched. -->
    <string name="filter_channel">Ad filter</string>
    <string name="filter_starting">Starting the ad filter…</string>
    <string name="filter_running">Ad filter on · %1$d rules</string>
    <string name="filter_off_because">Ad filter off — %1$s</string>
    <string name="filter_not_permitted">this phone has not allowed the connection yet</string>
    <string name="filter_carried_nothing">it carried no traffic, so it was switched off</string>
    <!--
      FR-6.11, the four cases that used to report nothing at all. A tunnel that is not running and
      has no words for it is indistinguishable from one that is about to start, which is the state
      the family phone sat in for a day while the console said the filter was on.
    -->
    <string name="filter_off_starting">the filter is starting on this phone</string>
    <string name="filter_off_not_started">the phone was asked to start the filter and it has not started</string>
    <string name="filter_off_refused">Android refused to start the filter service (%1$s)</string>
    <string name="filter_off_revoked">the connection was switched off on the phone</string>
    <string name="filter_off_service_stopped">the filter stopped on the phone</string>
    <string name="filter_off_no_forwarder">the filter could not open the socket it forwards queries through</string>
    <!-- Remote debugging (FR-19). Shown on the child's phone while a parent is connected over adb:
         a remote shell on somebody's phone must be visible to them. -->
    <string name="debug_channel">Remote debugging</string>
    <string name="debug_connected_title">A parent is connected for debugging</string>
    <string name="debug_connected_text">Your parent is looking at this phone over adb to fix a problem.</string>
    <!-- Why apps are paused, and today's screen time (FR-3.10). Read by a child: the phone's own
         language wins, and values-de carries the German. The first three are the line Android
         shows on its "blocked by your administrator" screen, which it truncates past 200
         characters. -->
    <string name="why_quota">Daily limit reached: %1$d of %2$d minutes used. Your apps are free again at midnight. Ask your parents if you need more time.</string>
    <string name="why_bedtime">Bedtime until %1$s. Your apps are paused until then.</string>
    <string name="why_app">This app is blocked by your parents, has its own limit used up, or is waiting for their approval. Open FamilyGuard to see which.</string>
    <string name="limits_channel">Screen time</string>
    <string name="limits_title_quota">Daily limit reached</string>
    <string name="limits_title_bedtime">Bedtime</string>
    <string name="today_heading">Today</string>
    <string name="today_used">Screen time: %1$d of %2$d min</string>
    <string name="today_used_bonus">Screen time: %1$d of %2$d min (incl. %3$d min extra)</string>
    <string name="today_used_nolimit">Screen time: %1$d min (no daily limit)</string>
    <string name="today_no_apps">No app used today yet.</string>
    <string name="app_minutes">%1$d min</string>
    <string name="app_minutes_of">%1$d of %2$d min</string>
    <string name="rule_always_free">Always free</string>
    <string name="rule_own_limit">Own limit: %1$d min a day</string>
    <string name="rule_counts">Counts toward the daily limit</string>
    <string name="rule_not_counted">Not counted</string>
    <string name="rule_blocked">Blocked by your parents</string>
    <string name="block_quota">Paused: daily limit reached</string>
    <string name="block_bedtime">Paused: bedtime</string>
    <string name="block_app_limit">Paused: its own limit is used up</string>
    <string name="block_blocked">Blocked by your parents</string>
    <string name="block_pending">Waiting for your parents\' approval</string>
</resources>
