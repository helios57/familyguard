<?xml version="1.0" encoding="utf-8"?>
<!--
  One labelled fact on the status block (FR-13.4).

  Two lines rather than a label/value pair on one, because the values are sentences — "version 9 was
  sent, but this phone is still applying version 7" does not fit beside its label on a 360 dp phone
  in any font scale, and a value that wraps under a right-aligned label is unreadable.

  The whole row carries one `contentDescription`, set in code, so a screen reader says "Needs
  attention. Screen time today: not measured…" as one sentence instead of reading a label and a
  value as two unrelated fragments. The children are marked `no` so they are not also read
  individually.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:focusable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/status_row_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/status_row_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textIsSelectable="true" />

    <!--
      The way to fix this row, GONE on every row that has nothing to fix — which is most of them,
      and all of them once the phone is set up correctly.

      `wrap_content` and start-aligned rather than the full-width buttons above: those two are the
      screen's purpose and this is a subordinate action on one line of a report. A second
      full-width button would compete with the recovery button for the same glance, on the screen
      whose entire reason for existing is that button.

      It carries its own `contentDescription` because the row's description is set on the row, and a
      screen reader reaching the button by swipe would otherwise announce only "Open settings" with
      no way to know which of the two it opens. 48dp because it is a real tap target on a phone
      being held by somebody who is already annoyed.
    -->
    <Button
        android:id="@+id/status_row_fix"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/status_fix"
        android:visibility="gone" />

</LinearLayout>
