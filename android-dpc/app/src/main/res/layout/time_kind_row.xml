<?xml version="1.0" encoding="utf-8"?>
<!--
  One kind of time on the time card (FR-28.3): a colour mark, its name, how much, and in one line
  below when it ends. The mark's colour is the kind's everywhere — the console's rows use the same
  three — so Extrazeit and Bonuszeit are never one gold. One contentDescription, set in code.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <View
            android:id="@+id/kind_mark"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/kind_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/kind_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
    </LinearLayout>

    <TextView
        android:id="@+id/kind_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
