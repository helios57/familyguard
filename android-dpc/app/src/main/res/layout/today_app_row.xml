<?xml version="1.0" encoding="utf-8"?>
<!--
  One app on the Today block (FR-3.10): its name and minutes, a bar, and what governs it.

  The bar's secondary progress is the app's own limit, so a child sees how far along it is and
  where it stops. Progress values are set in code against one scale for the whole list, so two apps
  can be compared by eye. One contentDescription for the row, set in code, for the same reason
  status_row has one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/today_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/today_app_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/today_app_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/today_app_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
