<?xml version="1.0" encoding="utf-8"?>
<!--
  The only screen this app has, and the only one it should have (FR-12).

  It is a scrolling single column rather than a constrained layout because of where it gets used: a
  parent standing over a phone that has locked their child out, on whatever handset the family owns,
  with the keyboard covering the bottom half of the screen. A ScrollView means the button is always
  reachable; a fixed layout means it is reachable on the screen it was designed on.

  Nothing here is sized in `dp` that carries text, and nothing is coloured literally: the theme is
  DayNight, so a hard-coded colour is a screen that is unreadable for whoever has dark mode on, and
  a `dp` text size is one that ignores the font scale a parent set because they cannot read small
  text. Both are exactly the person this screen exists for.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!--
          Today, first (FR-3.10). The screen a child opens when their apps are paused, so what they
          came for — why, and how much of the day is used — is at the top. Hidden until it has been
          computed, and stays hidden on a phone that has never received a policy: an empty "Today"
          block is the screen this feature exists to prevent.
        -->
        <LinearLayout
            android:id="@+id/today_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/today_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/today_heading"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <!-- FR-23.5: the next alarm, first thing under the heading. -->
            <TextView
                android:id="@+id/today_alarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:visibility="gone" />

            <!-- FR-24.5: now and next from the agenda, and tomorrow. -->
            <TextView
                android:id="@+id/today_agenda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone" />

            <!--
              FR-28.3: the child's time as one card — how much is left, then the three kinds it is
              made of, each saying when it ends (owner, 2026-10-01: "bonus time stays a week,
              additional time stays till midnight, daily time is reset at midnight"), and
              "Mehr Zeit erbitten". Before, two sentences said three kinds of time:
              "Bildschirmzeit: 0 von 105 Min. (inkl. 15 Min. extra)" and a gold "Bonuszeit" line.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/time_card"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/today_left"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

                    <!-- Used against the day's time plus today's Extrazeit. Gone with no limit. -->
                    <ProgressBar
                        android:id="@+id/today_meter"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/today_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/today_why"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />

                    <!-- Tageszeit, Extrazeit, Bonuszeit: one time_kind_row each. -->
                    <LinearLayout
                        android:id="@+id/time_kinds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/ask_time"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="56dp"
                        android:text="@string/ask_time"
                        android:visibility="gone"
                        app:icon="@android:drawable/ic_menu_recent_history" />

                    <TextView
                        android:id="@+id/ask_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/time_help_toggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="48dp"
                        android:paddingStart="0dp"
                        android:text="@string/time_help_toggle" />

                    <TextView
                        android:id="@+id/time_help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/time_help"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/today_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/today_plan_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/today_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!--
          Everything below is for a parent: the escape hatch, re-linking, and what the phone knows
          about itself. Said once, so a child reading the screen knows where their part ends.
        -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/parent_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/parent_section"
            android:textAllCaps="true"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView
            android:id="@+id/recovery_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recovery_title"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:id="@+id/recovery_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/recovery_explanation"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!--
          `textCapCharacters` because the code is printed in upper case and a parent copying it will
          not switch the keyboard; `textNoSuggestions` because a recovery code must not end up in the
          keyboard's learned dictionary, where the next person to type "F" would be offered it.
          `importantForAutofill="no"` for the same reason one layer up.

          The verifier normalises case, spacing and the group separators, so none of this is load
          bearing — it is what stops the screen from rejecting a correctly-copied code for looking
          different, which is the failure that makes a parent conclude the hatch is broken.
        -->
        <EditText
            android:id="@+id/recovery_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:hint="@string/recovery_code_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <Button
            android:id="@+id/recovery_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/recovery_submit" />

        <!--
          Empty until something has happened. A status line pre-filled with "ready" is one more thing
          to read past, and it makes the screen look as though it has already answered.
        -->
        <TextView
            android:id="@+id/recovery_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textIsSelectable="true" />

        <!--
          FR-1.8: re-linking, hidden until the server has actually refused this device's credential.

          Below the recovery field, and gone entirely the rest of the time. Two text boxes on the
          one screen a person can start is one too many for the situation the screen exists for —
          somebody standing over a locked phone — and a parent who mistakes the setup-code field for
          the recovery-code field learns nothing from either rejection. It appears only in the state
          where the recovery code alone cannot help, which is also the only state where a setup code
          means anything.
        -->
        <LinearLayout
            android:id="@+id/relink_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!--
              One line until it is needed: a toggle that opens the fields. It opens by itself when the
              server has refused this phone, which is the one state the fields are certainly for.
              A toggle rather than hiding the section, because hiding it is what made a parent ask
              "how to relink? don't see a button".
            -->
            <Button
                android:id="@+id/relink_toggle"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:text="@string/relink_heading" />
            <LinearLayout
                android:id="@+id/relink_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                android:id="@+id/relink_explain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/unlinked_text"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!--
              Not `textCapCharacters`, unlike the recovery field above it: a setup code is
              base64url and its case is load bearing, so a keyboard that helpfully upper-cased it
              would turn every paste into a rejection. `textNoSuggestions|textVisiblePassword` for
              the same two reasons as above — out of the learned dictionary, and visible, because
              somebody is typing 43 characters they cannot see.
            -->
            <EditText
                android:id="@+id/relink_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:hint="@string/relink_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <Button
                android:id="@+id/relink_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/relink_submit" />

            <TextView
                android:id="@+id/relink_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>

        <!--
          What this phone knows about itself (FR-13.4).

          Below the code field on purpose. The screen's reason for existing is the escape hatch, and
          the person who needs that is standing over a phone with a keyboard already covering half of
          it; making them scroll past a status report to reach the field would be the status report
          costing somebody the thing they came for. A parent who came to *read* scrolls once.

          The rows are added at runtime, so this is an empty container rather than a set of stubs: a
          stub row is a row that renders before it has been filled, and "Screen time today:" with an
          empty value is exactly the screen this feature exists to prevent.
        -->
        <View
            android:id="@+id/status_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="?attr/colorOutlineVariant"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/status_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/status_heading"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/status_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_loading"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/status_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Pushes the footer to the bottom on a tall screen and disappears on a short one. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/recovery_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/recovery_footer"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</ScrollView>
